#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "L0";

            // default_layer (L0) — Tap = Buchstabe, Hold = Mod auf der Home-Row
            //  Q   W   E   R   T  |  Y   U   I   O   P
            //  A   S   D   F   G  |  H   J   K   L  SL3     S=Ctrl D=Opt F=Cmd | J=Cmd K=Opt L=Ctrl
            //  Z   X   C   V   B  |  N   M   ,   .  ESC     SL3 = sticky →L3 (Umlaute)
            //           TAB SPC DEL | BSPC ENT →L1          ESC = Tap Esc / Hold Hyper (⌃⌥⌘⇧)


            bindings = <
&none  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &none  &none  &kp A  &mt LCTRL S  &mt LEFT_ALT D  &mt LCMD F  &kp G  &kp H  &mt RCMD J  &mt RIGHT_ALT K  &mt RCTRL L  &sl 3  &none  &none  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &mt LA(LC(LG(LEFT_SHIFT))) ESCAPE  &none  &kp TAB  &kp SPACE  &kp DELETE  &kp BACKSPACE  &mt LEFT_SHIFT ENTER  &to 1
            >;
        };

        symbol_layer {
            display-name = "L1";

            // symbol_layer (L1)
            //  \   &   |   %   @  |  ^   #   !   ?   §
            //  <   [   {   (   "  |  '   )   }   ]   >
            //  /   ´   `   ~   _  |  €   $   ;   :  ESC
            //           TAB →L0 DEL | BSPC ENT →L2            

            bindings = <
&none  &kp LS(LA(NUMBER_7))  &kp LS(NUMBER_6)  &kp LA(NUMBER_7)  &kp LS(NUMBER_5)  &kp LA(L)  &kp CARET  &kp BSLH  &kp LS(NUMBER_1)  &kp LS(MINUS)  &kp LS(NUMBER_3)  &none  &none  &kp NON_US_BSLH  &kp LA(NUMBER_5)  &kp LA(NUMBER_8)  &kp LS(NUMBER_8)  &kp LS(NUMBER_2)  &kp LS(BSLH)  &kp LS(NUMBER_9)  &kp LA(NUMBER_9)  &kp LA(NUMBER_6)  &kp LS(NON_US_BSLH)  &none  &none  &kp LS(NUMBER_7)  &kp EQUAL  &kp LS(EQUAL)  &kp LA(N)  &kp LS(SLASH)  &kp LA(E)  &kp LS(NUMBER_4)  &kp LS(COMMA)  &kp LS(PERIOD)  &mt LA(LC(LG(LEFT_SHIFT))) ESCAPE  &none  &kp TAB  &to 0  &kp DELETE  &kp BACKSPACE  &mt LEFT_SHIFT ENTER  &to 2
            >;
        };

        numberXctrl_layer {
            display-name = "L2";

            // numberXctrl_layer (L2) — Zahlen / Navigation / Medien
            //  *   7   8   9   +  | ▶⏸  ⏮  ⏭  ☀+
            //  =   4   5   6   0  |  ←   ↓   ↑   →          5=Hold Opt, 6=Hold Cmd
            //  /   1   2   3   -  | 🔇  🔉  🔊  ☀-  ESC
            //           TAB →L0 DEL | BSPC ENT →L1

            bindings = <
&none  &kp LS(RBKT)  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp RBKT  &kp C_PP  &kp C_PREV  &kp C_NEXT  &kp C_BRIGHTNESS_MAXIMUM  &none  &none  &none  &kp LS(NUMBER_0)  &kp NUMBER_4  &mt LEFT_ALT NUMBER_5  &mt LCMD NUMBER_6  &kp NUMBER_0  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none  &none  &none  &kp LS(NUMBER_7)  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_BRI_DN  &mt LA(LC(LG(LEFT_SHIFT))) ESCAPE  &none  &kp TAB  &to 0  &kp DELETE  &kp BACKSPACE  &mt LEFT_SHIFT ENTER  &to 1
            >;
        };

        german_umlauts_layer {
            display-name = "L3";

        // german_umlauts_layer (L3) — Rest = &trans (fällt auf Base durch)
        //         | ü       ö 
        //  ä   ß  |           

            bindings = <
&none  &trans  &trans  &trans  &trans  &trans  &trans  &kp LBKT  &trans  &kp SEMI  &trans  &none  &none  &kp SINGLE_QUOTE  &kp MINUS  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none  &none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        extra_layer_2 {
            display-name = "EXTRA 2";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        extra_layer_3 {
            display-name = "EXTRA 3";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
